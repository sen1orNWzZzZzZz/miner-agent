# 复制为 .env 后按需填写

# LLM 配置（二选一）
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 外部 API（可选，不填则使用 mock）
CURRENTS_API_KEY=
METALS_API_KEY=
# MetalpriceAPI 免费 key（https://metalpriceapi.com）— 价格/走势数据源，留空则用 mock
METALPRICE_API_KEY=

# 演示模式：true 时无需任何 API Key
USE_MOCK=true

# 日志
LOG_LEVEL=INFO

# Agent 服务端口
AGENT_PORT=3000

# MCP Server 端口
NEWS_MCP_PORT=8000
PDF_MCP_PORT=8001
PRICE_MCP_PORT=8002
